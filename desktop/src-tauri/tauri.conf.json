{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYNERGY AI WORKSPACE",
  "version": "0.8.0",
  "identifier": "ai.synergy.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SYNERGY AI WORKSPACE",
        "width": 1440,
        "height": 900,
        "minWidth": 950,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src http://127.0.0.1:8129; img-src 'self' data:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}